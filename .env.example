# Supabase project — required. Both values are safe to expose to the browser;
# the anon key is only useful in combination with row level security policies.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional local-only escape hatch for calling Gemini directly instead of going
# through the Supabase edge function. Never set this in a deployed environment —
# it would ship the key to every visitor.
VITE_GEMINI_API_KEY=
