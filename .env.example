# ---------------------------------------------------------------------------
# Client (bundled into the browser build — must contain nothing secret)
# ---------------------------------------------------------------------------

# Clerk publishable key. Dashboard -> API keys.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx

# Local development escape hatch: calls Google directly when the API function is
# unavailable. Leave this UNSET in every deployed environment — anything with a
# VITE_ prefix is compiled into the JavaScript bundle and is readable by anyone.
# VITE_GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Server (Vercel Functions only — never prefixed with VITE_)
# ---------------------------------------------------------------------------

# Clerk secret key, used to verify session tokens on the API side.
CLERK_SECRET_KEY=sk_test_xxx

# Neon pooled connection string.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Gemini API key. Only the /api/gemini function reads this.
GEMINI_API_KEY=

# Vercel Blob read/write token. Set automatically when you link a Blob store;
# only needed explicitly for local development.
BLOB_READ_WRITE_TOKEN=

# Comma-separated origins allowed to call the API. Localhost is always allowed.
# ALLOWED_ORIGINS=https://thaiid.vercel.app
